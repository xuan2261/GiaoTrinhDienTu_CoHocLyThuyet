      { "key": "phi", "selector": ".sim2-readout-value", "physFn": "staticLimitAngle(mu)*180/pi=atan(mu)*180/pi", "expectSign": "+", "safeRange": [0.1, 1.0],
        "notes": "FD mu=0.45→0.5 phi=24.228→26.565 sign=+. Probe: slider mu." },
      { "key": "beta", "selector": ".sim2-readout-value", "physFn": "state.betaDeg (identity)", "expectSign": "+", "safeRange": [3, 60] }
    ],
    "bMode": "local-monotonic",
    "notes": "phi=atan(mu) is monotonically increasing (no extrema) over [0.1,1.0]. Trạng_thai readout is categorical (slip/no-slip), not a numeric sign probe."
  },

