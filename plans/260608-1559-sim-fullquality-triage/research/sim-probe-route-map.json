      { "key": "Cy", "selector": ".sim2-readout-value", "physFn": "centroidWithHole→cy", "expectSign": "-", "safeRange": [1, 3],
        "notes": "FD: hole.cy=2.5→3 Cy=1.9247→1.8494 sign=-. Same logic applies to y." }
    ],
    "bMode": "a-only",
    "reason": "Bespoke 2D drag (ch1-6-3 is one of the 5 bespoke-drag routes). Cx and Cy each track one drag dimension with sign=-. However drag controls both axes simultaneously with unconstrained direction — no single scalar control. Probe B can split into Cx-vs-drag-x and Cy-vs-drag-y separately if probe constrains axis.",
    "notes": "Handle class: .sim2-handle. Drag constrained to [r, 6-r] x [r, 4-r] where r=1."
  },

  "ch2-1-1": {
    "engine": "sim2",
    "chapter": 2,
    "controls": [
      { "kind": "slider", "id": "v0",    "physInput": "initial speed", "min": 8,  "max": 20, "step": 1 },
      { "kind": "slider", "id": "alpha", "physInput": "launch angleDeg", "min": 20, "max": 80, "step": 5 },
      { "kind": "playback", "selector": ".sim2-playpause" }
    ],
    "readouts": [
      { "key": "v", "selector": ".sim2-readout-value", "physFn": "velocityFromTrajectory→|v|", "expectSign": "+", "safeRange": [8, 20],
        "notes": "FD v0=14→15 at t=1: speed=8.199→8.953 sign=+. Probe slider v0." },
      { "key": "a", "selector": ".sim2-readout-value", "physFn": "accelerationFromVelocity→|a|~9.81", "expectSign": "0",
        "notes": "|a|≈g=9.81 constant regardless of v0/alpha (gravity only); effectively constant." }
    ],
    "bMode": "scene-delta",
    "reason": "Playback-driven: readout changes each frame (t advances). Slider-only readout is at reset state t=0 (speed=v0*cos(alpha)+...). After reset, slider v0 → v at t=0 is v0 itself. Use scene-delta: liveness verified by pressing play and checking readout changes."
  },

