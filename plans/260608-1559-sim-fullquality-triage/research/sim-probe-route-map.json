{
  "ch1-1-3": {
    "engine": "sim2",
    "chapter": 1,
    "controls": [
      { "kind": "slider", "id": "F", "physInput": "magnitude", "min": 10, "max": 120, "step": 1 },
      { "kind": "slider", "id": "alpha", "physInput": "angleDeg", "min": 0, "max": 90, "step": 1 },
      { "kind": "drag-handle", "selector": ".sim2-handle", "physInput": "tip position → F+alpha" }
    ],
    "readouts": [
      { "key": "F",     "selector": ".sim2-readout-value", "physFn": "resolveForceComponents→|F|", "expectSign": "+", "safeRange": [10, 120], "notes": "readout label |F|: tracks slider F directly" },
      { "key": "Fx",    "selector": ".sim2-readout-value", "physFn": "resolveForceComponents→fx", "expectSign": "+", "safeRange": [1, 89], "notes": "Fx=F*cos(alpha); + for alpha in [0,89]" },
      { "key": "Fy",    "selector": ".sim2-readout-value", "physFn": "resolveForceComponents→fy", "expectSign": "+", "safeRange": [1, 89], "notes": "Fy=F*sin(alpha); + for alpha in (0,90)" },
      { "key": "alpha", "selector": ".sim2-readout-value", "physFn": "state.alphaDeg", "expectSign": "+", "safeRange": [0, 90] }
    ],
    "bMode": "monotonic",
    "notes": "Dual input: slider F/alpha + drag-handle (both write same state). Slider F sign on Fx is + when alpha<90."
  },

  "ch1-1-4": {
    "engine": "sim2",
    "chapter": 1,
    "controls": [
      { "kind": "slider", "id": "F", "physInput": "force magnitude", "min": 10, "max": 100, "step": 5 },
      { "kind": "drag-handle", "selector": ".sim2-handle", "physInput": "app.x → arm length d" }
    ],
    "readouts": [
      { "key": "M", "selector": ".sim2-readout-value", "physFn": "computeMoment(F,d,90)=F*d", "expectSign": "+", "safeRange": [0.5, 6.5],
        "notes": "FD: F=50,d=4→M=200; F=51→M=204; sign=+. d=4→5→M=250; sign=+" }
    ],
    "bMode": "monotonic",
    "notes": "Fdir=90 fixed; M=F*d, both controls increase M monotonically."
  },

  "ch1-1-5": {
    "engine": "sim2",
    "chapter": 1,
    "controls": [
      { "kind": "drag-handle", "selector": ".sim2-handle", "physInput": "force tip positions F1/F2" }
    ],
    "readouts": [
      { "key": "Rx",  "selector": ".sim2-readout-value", "physFn": "reduceToResultant→Rx", "expectSign": "+", "safeRange": null,
        "notes": "Rx = fx1+fx2; sign depends on drag direction. Not monotonic in general." },
      { "key": "Mo",  "selector": ".sim2-readout-value", "physFn": "reduceToResultant→Mo", "expectSign": null, "safeRange": null }
    ],
    "bMode": "scene-delta",
    "reason": "Bespoke 2-handle drag: no slider; resultant direction depends on arbitrary drag. No monotonic scalar control→readout chain. Liveness (Δ≠0) testable by dragging either handle.",
    "notes": "5 bespoke-drag routes include ch1-1-5. Handle class: .sim2-handle (shell.addHandle)"
  },

  "ch1-1-5#sim3": {
    "engine": "sim3",
    "chapter": 1,
    "controls": "same as ch1-1-5 (Sim2 controls drive state)",
    "debugPath": "__SIM3_DEBUG__['ch1-1-5']",
    "debugFields": ["resultant.Rx", "resultant.Ry", "resultant.Mo"],
    "readouts": [
      { "key": "Rx", "debugPath": "__SIM3_DEBUG__['ch1-1-5'].resultant.Rx", "physFn": "reduceToResultant→Rx" },
      { "key": "Mo", "debugPath": "__SIM3_DEBUG__['ch1-1-5'].resultant.Mo", "physFn": "reduceToResultant→Mo" }
    ],
    "bMode": "scene-delta",
    "reason": "Mirrors ch1-1-5 scene-delta; 3D reads state from same drag-handle input."
  },

  "ch1-1-6": {
    "engine": "sim2",
    "chapter": 1,
    "controls": [
      { "kind": "slider", "id": "d", "physInput": "couple distance", "min": 1, "max": 6, "step": 0.5 },
