      { "key": "R", "selector": ".sim2-readout-value", "physFn": "R=P (constant, R always equals P)", "expectSign": "+", "safeRange": [20, 150],
        "notes": "R=P; slider P sign=+" }
    ],
    "bMode": "monotonic"
  },

  "ch1-5-3": {
    "engine": "sim2",
    "chapter": 1,
    "controls": [
      { "kind": "slider", "id": "beta", "physInput": "incline angleDeg", "min": 3, "max": 60, "step": 1 },
