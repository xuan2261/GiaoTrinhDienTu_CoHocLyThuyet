    ],
    "readouts": [
      { "key": "M_couple", "selector": ".sim2-readout-value", "physFn": "coupleMoment(50,d)=50*d", "expectSign": "+", "safeRange": [1, 6],
        "notes": "FD: d=3→M=150; d=3.5→M=175; sign=+" }
    ],
    "bMode": "monotonic"
  },

  "ch1-1-8": {
    "engine": "sim2",
    "chapter": 1,
    "controls": [
      { "kind": "slider", "id": "P", "physInput": "load magnitude", "min": 20, "max": 200, "step": 10 },
      { "kind": "drag-handle", "selector": ".sim2-handle", "physInput": "state.pos → load position a" }
    ],
    "readouts": [
      { "key": "Ra", "selector": ".sim2-readout-value", "physFn": "beamReactions→ra=P*(L-a)/L", "expectSign": "+", "safeRange": [0.3, 9.7],
        "notes": "FD slider P: P=100→110 Ra=60→66 sign=+. FD drag a: a=4→5 Ra=60→50 sign=-. Probe slider P for Ra sign=+" },
      { "key": "Rb", "selector": ".sim2-readout-value", "physFn": "beamReactions→rb=P*a/L", "expectSign": "+", "safeRange": [0.3, 9.7],
        "notes": "FD drag a: a=4→5 Rb=40→50 sign=+. Probe slider P for Rb also sign=+" }
    ],
    "bMode": "monotonic",
    "notes": "Ra decreases as a increases (load moves toward B); use slider P as probe control for both reactions (sign=+)."
  },

  "ch1-2-3": {
    "engine": "sim2",
    "chapter": 1,
    "controls": [
      { "kind": "drag-handle", "selector": ".sim2-handle", "physInput": "f1/f2 tip positions" }
    ],
    "readouts": [
      { "key": "|R|", "selector": ".sim2-readout-value", "physFn": "vector sum |R|=|F1+F2|", "expectSign": null }
    ],
    "bMode": "a-only",
    "reason": "Bespoke parallelogram drag (ch1-2-3 is one of the 5 bespoke-drag routes). Both handles move freely in 2D; |R| depends on arbitrary geometry. No scalar monotonic chain. Liveness testable by dragging h1 or h2."
  },

  "ch1-3-2": {
    "engine": "sim2",
    "chapter": 1,
    "controls": [
      { "kind": "slider", "id": "alpha", "physInput": "angleDeg", "min": 5, "max": 75, "step": 1 },
      { "kind": "drag-handle", "selector": ".sim2-handle", "physInput": "anchor position → alpha" }
    ],
    "readouts": [
      { "key": "T", "selector": ".sim2-readout-value", "physFn": "W/(2*cos(alpha))=100/(2*cos(α))", "expectSign": "+", "safeRange": [5, 75],
        "notes": "FD: alpha=30→31 T=57.735→58.332 sign=+. T monotonically increases as alpha increases (cos decreases)." }
    ],
    "bMode": "local-monotonic",
    "notes": "T→∞ as alpha→90; safe range [5,75] avoids alpha=90 singularity (extremum avoided at upper bound)."
  },

  "ch1-3-6": {
    "engine": "sim2",
    "chapter": 1,
    "controls": [
      { "kind": "slider", "id": "P", "physInput": "load magnitude", "min": 20, "max": 150, "step": 10 },
