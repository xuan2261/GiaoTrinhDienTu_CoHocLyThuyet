{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cohoclythuyet.local/schemas/release-manifest.schema.json",
  "title": "Deterministic standalone release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseVersion", "buildEpoch", "launchPath", "builder", "policy", "provenance", "exclusions", "files", "payloadSha256"],
  "properties": {
    "schemaVersion": {"const": 2},
    "releaseVersion": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(?:-[a-z0-9.-]+)?$"},
    "buildEpoch": {"type": "integer", "minimum": 315532800},
    "launchPath": {"const": "index.html"},
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"const": "tools/release/release.py"}, "version": {"const": 1}}
    },
    "policy": {"$ref": "#/$defs/hashedPath"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentManifest", "sourceDocx", "sourcePdf", "thirdParty"],
      "properties": {
        "contentManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "contentHash"],
          "properties": {
            "path": {"const": "data/content-manifest.json"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "contentHash": {"$ref": "#/$defs/sha256"}
          }
        },
        "sourceDocx": {"$ref": "#/$defs/hashedPath"},
        "sourcePdf": {"$ref": "#/$defs/hashedPath"},
        "thirdParty": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/thirdParty"}}
      }
    },
    "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "payloadSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "hashedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sizeBytes", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sizeBytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "reason": {"type": "string", "minLength": 1}}
    },
    "thirdParty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "license", "source"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "source": {"type": "string", "pattern": "^https://"}
      }
    }
  }
}
